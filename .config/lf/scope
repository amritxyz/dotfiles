#!/bin/sh
# sudo pacman -S file bat chafa ffmpegthumbnailer mediainfo lesspipe inkscape atool

image() {
    chafa -f sixels -s "$2x$3" --animate off --polite on "$1"
}

CACHE_DIR="$HOME/.cache/lf"
mkdir -p "$CACHE_DIR"
CACHE="$CACHE_DIR/thumb.$(stat --printf '%n\0%i\0%F\0%s\0%W\0%Y' -- "$(readlink -f "$1")" | sha256sum | awk '{print $1}')"

case "$(file --dereference --brief --mime-type -- "$1")" in
    image/svg+xml)
        [ ! -f "$CACHE.png" ] && inkscape --convert-dpi-method=none -o "$CACHE.png" \
            --export-overwrite -D "$1" > /dev/null 2>&1
        image "$CACHE.png" "$2" "$3" ;;
    image/*)
        image "$1" "$2" "$3" ;;
    video/*)
        [ ! -f "$CACHE.jpg" ] && ffmpegthumbnailer -i "$1" -o "$CACHE.jpg" -s 0
        image "$CACHE.jpg" "$2" "$3" ;;
    application/pdf|*/pdf)
        [ ! -f "$CACHE.jpg" ] && pdftoppm -jpeg -f 1 -singlefile "$1" "$CACHE"
        image "${CACHE}.jpg" "$2" "$3" ;;
    audio/*)
        mediainfo "$1" ;;
    text/html)
        lynx -width="$2" -display_charset=utf-8 -dump "$1" ;;
    text/troff)
        man ./ "$1" | col -b ;;
    text/*|application/json|application/javascript|*/xml)
        cat "$1" ;;
    application/*zip|application/x-tar|application/x-bzip2|application/x-xz)
        atool --list -- "$1" ;;
    *opendocument*)
        odt2txt "$1" ;;
    *)
        lesspipe "$1" || cat "$1" ;;
esac
exit 1
