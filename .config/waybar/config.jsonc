{
	"layer": "top",
	"position": "top",
	"spacing": 0,
	"height": 20,

	"margin-top": 0,
	"margin-right": 0,
	"margin-bottom": 0,
	"margin-left": 0,

	"modules-left": [
		"mango/workspaces",
		"mango/layout",
		"mango/window"
	],

	"modules-center": [],

	"modules-right": [
		"tray",
		"temperature",
		"custom/separator",
		"cpu",
		"custom/separator",
		"memory",
		"custom/separator",
		"network",
		"custom/separator",
		"pulseaudio",
		"custom/separator",
		"battery",
		"custom/separator",
		"clock"
	],

	"mango/workspaces": {
		"hide-empty": true,
		"on-click": "activate",
		"on-click-right": "toggle",
		"on-scroll-up": "mmsg dispatch viewtoleft_have_client,0",
		"on-scroll-down": "mmsg dispatch viewtoright_have_client,0",
		"tooltip": false
	},

	"mango/layout": {
		"format": "[]=",
		"format-T": "[]=",
		"format-VT": "TTT",
		"format-CT": "|M|",
		"format-RT": "=[]",
		"format-M": "[M]",
		"format-K": "[D]",
		"format-VK": "[D]",
		"format-DW": "[\\]",
		"format-S": "[S]",
		"format-VS": "[VS]",
		"format-G": "###",
		"format-VG": "###",
		"format-F": "|||",
		"format-VF": "---",
		"on-click": "mmsg dispatch switch_layout",
		"on-click-right": "mmsg dispatch setlayout,tile",
		"on-scroll-up": "mmsg dispatch switch_layout",
		"on-scroll-down": "mmsg dispatch switch_layout",
		"tooltip": false
	},

	"mango/window": {
		"format": "{title}",
		"icon": false,
		"max-length": 100,
		"on-click-middle": "mmsg dispatch zoom",
		"tooltip": false
	},

	"tray": {
		"icon-size": 14,
		"spacing": 6,
		"tooltip": false
	},

	"temperature": {
		"format": "{temperatureC}°c",
		"interval": 5,
		"hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
		"critical-threshold": 80,
		"tooltip": false
	},

	"cpu": {
		"format": "cpu {usage}%",
		"interval": 2,
		"states": {
			"critical": 90
		},
		"tooltip": false
	},
	"cpu": {
		"format": "cpu {usage}%",
		"interval": 2,
		"states": { "critical": 90 },
		"on-click-right": "notify-send 'CPU hogs' \"$(ps axch -o cmd:15,%cpu --sort=-%cpu | head)\"",
		"tooltip": false
	},

	"memory": {
		"format": "mem {percentage}%",
		"interval": 2,
		"states": { "critical": 80 },
		"on-click-right": "notify-send 'Memory hogs' \"$(ps axch -o cmd:15,%mem --sort=-%mem | head)\"",
		"tooltip": false
	},

	"network": {
		"format-wifi": "wifi {bandwidthDownBits}",
		"format-ethernet": "enth {bandwidthDownBits}",
		"format-disconnected": "no network",
		"interval": 5,
		"on-click": "notify-send 'Network' \"$(printf 'wifi: wifi connected\\neth: ethernet working\\nno network: disconnected')\"",
		"on-click-middle": "pkill -x nmtui || setsid -f foot -a float_win -e nmtui",
		"on-click-right": "pkill -x bmon || setsid -f foot -c ~/.config/foot/bmon.ini -a float_win -e bmon",
		"tooltip": false
	},

	"pulseaudio": {
		"scroll-step": 2,
		"max-volume": 150,
		"format": "{icon} {volume}%",
		"format-bluetooth": "bt {volume}%",
		"format-muted": "mute {volume}%",
		"format-icons": { "default": "vol", "headphone": "hp", "headset": "hp" },
		"on-click-middle": "wpctl set-mute @DEFAULT_SINK@ toggle",
		"on-click-right": "notify-send 'Volume' \"$(printf 'Scroll up: increase\\nScroll down: decrease\\nMiddle-click: toggle mute')\"",
		"tooltip": false
	},

	"battery": {
		"format": "bat {capacity}%",
		"format-charging": "chr {capacity}%",
		"states": { "warning": 50, "critical": 30 },
		"on-click-right": "notify-send 'Battery' \"$(printf 'bat: discharging\\nchr: charging')\"",
		"events": {
			"on-discharging-warning": "notify-send -u critical 'Low Battery'",
			"on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
			"on-charging-80": "notify-send -u normal 'Battery Full!'",
			"on-discharging": "notify-send -u normal 'Power Switch' Discharging",
			"on-charging": "notify-send -u normal 'Power Switch' Charging'"
		},
		"tooltip": false
	},

	"clock": {
		"format": "{:%Y %b %d, %a %I:%M:%S %p}",
		"tooltip": false,
		"interval": 1,
		"on-click": "pkill -x calcurse || setsid -f foot -a float_win -e calcurse",
		"on-click-middle": "notify-send 'This Month' \"$(cal)\"",
		"on-click-right": "notify-send 'Appointments' \"$(calcurse -d3 2>/dev/null)\"",
		"calendar": {
			"mode": "month"
		}
	},

	"custom/separator": {
		"format": "|",
		"tooltip": false
	}
}
