{
	"layer": "top",
	"position": "top",
	"spacing": 0,
	"height": 20,

	"margin-top": 0,
	"margin-right": 0,
	"margin-bottom": 0,
	"margin-left": 0,

	"modules-left": [
		"mango/workspaces",
		"mango/layout",
		"mango/window"
	],

	"modules-center": [],

	"modules-right": [
		"tray",
		"temperature",
		"custom/separator",
		"cpu",
		"custom/separator",
		"memory",
		"custom/separator",
		"network",
		"custom/separator",
		"pulseaudio",
		"custom/separator",
		"battery",
		"custom/separator",
		"clock"
	],

	"mango/workspaces": {
		"hide-empty": true,
		"on-click": "activate",
		"on-click-right": "toggle",
		"on-scroll-up": "mmsg dispatch viewtoleft_have_client,0",
		"on-scroll-down": "mmsg dispatch viewtoright_have_client,0",
		"tooltip": false
	},

	"mango/layout": {
		"format": "[]=",
		"format-T": "[]=",
		"format-VT": "TTT",
		"format-CT": "|M|",
		"format-RT": "=[]",
		"format-M": "[M]",
		"format-K": "[D]",
		"format-VK": "[D]",
		"format-DW": "[\\]",
		"format-S": "[S]",
		"format-VS": "[VS]",
		"format-G": "###",
		"format-VG": "###",
		"format-F": "|||",
		"format-VF": "---",
		"on-click": "mmsg dispatch switch_layout",
		"on-click-right": "mmsg dispatch setlayout,tile",
		"on-scroll-up": "mmsg dispatch switch_layout",
		"on-scroll-down": "mmsg dispatch switch_layout",
		"tooltip": false
	},

	"mango/window": {
		"format": "{title}",
		"icon": false,
		"max-length": 100,
		"on-click-middle": "mmsg dispatch zoom",
		"tooltip": false
	},

	"tray": {
		"spacing": 6,
		"tooltip": false
	},

	"temperature": {
		"format": "{temperatureC}°c",
		"interval": 5,
		"hwmon-path": "/sys/class/hwmon/hwmon5/temp1_input",
		"critical-threshold": 80,
		"tooltip": false
	},

	"cpu": {
		"format": "cpu {usage}%",
		"interval": 2,
		"states": {
			"critical": 90
		},
		"tooltip": false
	},

	"memory": {
		"format": "mem {percentage}%",
		"interval": 2,
		"states": {
			"critical": 80
		},
		"tooltip": false
	},

	"network": {
		"format-wifi": "wifi {bandwidthDownBits}",
		"format-ethernet": "enth {bandwidthDownBits}",
		"format-disconnected": "no network",
		"interval": 5,
		"tooltip": false
	},

	"pulseaudio": {
		"scroll-step": 5,
		"max-volume": 150,
		"format": "{icon} {volume}%",
		"format-bluetooth": "bt {volume}%",
		"format-muted": "mute {volume}%",
		"format-icons": {
			"default": "vol",
			"headphone": "hp",
			"headset": "hp"
		},
		"nospacing": 1,
		"tooltip": false
	},

	"battery": {
		"format": "bat {capacity}%",
		"format-charging": "chr {capacity}%",
		"interval": 5,
		"states": {
			"warning": 20,
			"critical": 10
		},
		"tooltip": false
	},

	"clock": {
		"format": "{:%Y %b %d, %a %I:%M %p}",
		"tooltip": false
	},

	"custom/separator": {
		"format": "|",
		"tooltip": false
	}
}
